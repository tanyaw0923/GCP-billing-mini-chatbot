# GCP project that runs BigQuery queries (use PROJECT ID, not project number)
PROJECT_ID=your-real-gcp-project-id
# Billing export may live in a different GCP project
BILLING_PROJECT_ID=your-billing-export-project-id
BIGQUERY_DATASET=billing_export
BIGQUERY_TABLE=gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX
# Optional restrictions: empty means all available rows
BILLING_ACCOUNT_ID=
TARGET_PROJECT_ID=
INVOICE_MONTH=
# This is a reference value, NOT a balance obtained from GCP
CREDIT_START_AMOUNT=400
# Optional: exact promotion name from your billing export, to isolate the $400 grant
CREDIT_NAME=
ENABLE_GEMINI=false
GEMINI_MODEL=gemini-3-flash-preview
GOOGLE_CLOUD_LOCATION=global
